<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Scanning a page, and the plan that can come out of it. ADDENDUM-03 Parts 5, 6
      and 7. One button for every piece of paper: somebody standing in a hallway
      holding a sheet should not have to classify it before the app will look at it.
    -->

    <string name="scan_something">Scan something</string>
    <string name="scan_sub">A sheet from your therapist, a letter, anything on paper</string>
    <string name="scan_title">Scan something</string>
    <string name="scan_take">Take the photo</string>
    <string name="scan_another_page">Add another page</string>
    <string name="scan_done">That\'s all of it</string>
    <string name="scan_stays_here">This stays on your phone. The words are read here, on this device, and nothing is sent anywhere.</string>
    <string name="scan_no_camera">This phone has no camera the app can use. Everything else works.</string>
    <string name="scan_needs_camera">The app needs the camera to photograph a page. Nothing else uses it.</string>
    <string name="scan_allow">Allow the camera</string>
    <string name="scan_reading">Reading the page</string>
    <string name="scan_nothing_read">No words came off that one. Try again with more light, or keep it as a photo.</string>
    <plurals name="scan_pages">
        <item quantity="one">One page</item>
        <item quantity="other">%1$d pages</item>
    </plurals>

    <!-- The one question, after the app has looked. -->
    <string name="found_exercises">This looks like exercises someone gave you. Add them?</string>
    <string name="found_report">This looks like a report from a therapist. Explain it in plain words?</string>
    <string name="found_unclear">I\'m not sure what this is. What would you like to do?</string>
    <string name="found_out_of_scope">This isn\'t something the app reads. It\'s saved here if you want to keep it.</string>
    <string name="found_add_them">Add the exercises</string>
    <string name="found_explain">Explain it</string>
    <string name="found_keep">Just keep it</string>
    <string name="found_who">Who is it from?</string>
    <string name="found_who_hint">Your physio, your doctor, anyone</string>
    <string name="found_saw">What the app saw on the page</string>

    <!-- Confirming a plan, which is the only way anything is ever saved. -->
    <string name="plan_title">What they gave you</string>
    <string name="plan_intro">Here\'s what the app read. Check each line and change anything it got wrong. Nothing is saved until you say so.</string>
    <string name="plan_label">Whose is this?</string>
    <string name="plan_label_hint">Your physio, your OT</string>
    <string name="plan_save">Save the plan</string>
    <string name="plan_drop">Take out</string>
    <string name="plan_guessed">The app guessed this one</string>
    <string name="plan_unmatched">The app didn\'t recognise this one</string>
    <string name="plan_more_than_one">This could be more than one thing</string>
    <string name="plan_no_number">No number was given</string>
    <string name="plan_theirs">This is your therapist\'s, not ours. We\'ll keep track of it and leave it as they set it.</string>
    <!--
      "10 reps, twice a day". Both numbers are counts and the words between them agree
      with neither, so a plural would give identical items in every language.
    -->
    <string name="plan_reps" tools:ignore="PluralsCandidate">%1$d each time</string>
    <string name="plan_sets" tools:ignore="PluralsCandidate">%1$d rounds of %2$d</string>
    <string name="plan_hold" tools:ignore="PluralsCandidate">Hold %1$d seconds</string>
    <string name="plan_minutes" tools:ignore="PluralsCandidate">%1$d minutes</string>
    <string name="plan_a_day" tools:ignore="PluralsCandidate">%1$d times a day</string>
    <string name="plan_a_week" tools:ignore="PluralsCandidate">%1$d times a week</string>
    <string name="plan_other_day">Every other day</string>
    <string name="plan_each_side">Each side</string>

    <!-- How the two plans sit beside each other on Today. -->
    <string name="plan_from">From your %1$s</string>
    <string name="plan_them">therapist</string>
    <!--
      The eyebrow once a second therapist has given them one. With one plan the card
      says whose it is; with two it cannot, so each plan carries its own name inside
      and this only says what the card is.
    -->
    <string name="plan_yours">Your plans</string>
    <plurals name="plan_how_many">
        <item quantity="one">One movement</item>
        <item quantity="other">%1$d movements</item>
    </plurals>
    <string name="plan_also">Also, if you want more</string>
    <string name="settings_extras">The app\'s own suggestions</string>
    <string name="settings_extras_sub">Shown under your therapist\'s plan. Off leaves only theirs.</string>
    <string name="plan_also_off">Turn the app\'s extras off</string>
    <string name="plan_also_on">Turn the app\'s extras back on</string>
    <string name="plan_on_theirs_too">This one\'s on your %1$s\'s list too.</string>
    <string name="plan_conflict">Your plan has %1$s, and you said you avoid %2$s. Ask your therapist about it. We\'ll leave it in for now.</string>
    <string name="plan_review">When do you next see them?</string>
    <string name="plan_review_none">Not set</string>
    <string name="plan_review_sub">Optional. We\'ll say once, two days before.</string>
    <string name="plan_review_set">Set a date</string>
    <string name="plan_review_change">Change</string>
    <string name="plan_review_clear">No date after all</string>
    <string name="plan_review_soon">You see your %1$s on %2$s. Your page is ready.</string>
    <string name="plan_export">Make the page for your appointment</string>

    <!--
      The four ways in. ADDENDUM-03 Part 6. The camera is first because it is the
      one most people will use and the one that also handles a letter, which is
      Part 5's job and not this one. The other three are a plan and nothing else,
      and all four end on the confirmation screen above.
    -->
    <string name="ways_title">What have you got?</string>
    <string name="ways_intro">Photograph anything on paper. The other three are for your therapist\'s plan.</string>
    <string name="ways_camera">Something on paper</string>
    <string name="ways_camera_sub">A sheet, a letter, anything printed</string>
    <string name="ways_say">Say it out loud</string>
    <string name="ways_say_sub">What they asked you to do</string>
    <string name="ways_pick">Pick from the library</string>
    <string name="ways_pick_sub">Tap the movements they named</string>
    <string name="ways_type">Type it</string>
    <string name="ways_type_sub">One movement to a line</string>

    <!-- Typing it. The plainest way in, and the one the other two fall back to. -->
    <string name="type_title">Type their plan</string>
    <string name="type_how">One movement to a line, in their words.</string>
    <string name="type_hint">10 chair stands twice a day</string>

    <!-- Picking it off the library. Nothing is guessed: they tapped the movement. -->
    <string name="pick_title">Pick from the library</string>
    <string name="pick_how">Tap everything they asked you to do.</string>

    <!--
      Saying it out loud. The words are made on this phone or not at all: the only
      other way Android does this sends the sound to a server.
    -->
    <string name="spoken_title">Say it out loud</string>
    <string name="spoken_how">Say the whole thing in one go, in their words.</string>
    <string name="spoken_example">Like ten chair stands twice a day and heel raises.</string>
    <string name="spoken_stays_here">Your voice becomes words here, on this phone, and nothing is sent anywhere.</string>
    <string name="spoken_start">Start talking</string>
    <string name="spoken_listening">Listening</string>
    <string name="spoken_stop">That\'s all of it</string>
    <string name="spoken_heard">Here is what the app heard.</string>
    <string name="spoken_again">Say it again</string>
    <string name="spoken_nothing">Nothing came through that time. Try again, or type it instead.</string>
    <string name="spoken_not_here">This phone can only do that by sending your voice away, so the app will not.</string>
    <string name="spoken_needs_mic">The app needs the microphone to hear you. Nothing else uses it.</string>
    <string name="spoken_allow">Allow the microphone</string>

    <!-- Everything photographed, kept forever. -->
    <string name="documents_title">Your documents</string>
    <string name="documents_sub">Everything you have photographed, kept here</string>
    <string name="documents_none">Nothing scanned yet.</string>
    <string name="documents_from">From %1$s</string>
    <string name="documents_open">Open</string>
    <string name="documents_remove">Remove this document</string>

    <!--
      Every plan somebody has, with its own date. ADDENDUM-03 Part 6 says plans
      coexist, each labelled and each separate, so this screen shows all of them
      rather than the first one and a guess about the rest.
    -->
    <string name="plans_row">Your therapist and review date</string>
    <string name="plans_row_sub">The plans you have, and when you next go in</string>
    <string name="plans_title">Your therapist</string>
    <string name="plans_why">Each plan stays as the person who gave it to you set it. The app keeps track of it and changes nothing in it.</string>
    <string name="plans_none">Nothing here yet. Anything your therapist gives you can be added from Scan something.</string>
    <string name="plans_away">Put this plan away</string>
    <string name="plans_away_why">It stops being offered. What you already did from it stays in your history, and so does the page for your appointment.</string>

</resources>
