<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      The session, from ADDENDUM-03 Part 1. Every line here is either read out loud or
      read from two feet away by somebody standing up out of a chair, so they are all
      short and none of them has a subordinate clause in it.
    -->
    <string name="session_start">Start</string>
    <string name="session_starts_itself">It starts on its own in a moment, so you can put the phone down.</string>
    <string name="session_back">Back to it.</string>
    <string name="say_still_there">Still going? Just stop when you are done and I will move on.</string>
    <string name="session_hour_away">You were away a while, so this one is saved as far as it got.</string>
    <string name="say_starts_itself">Press when you\'re ready, or I\'ll start on my own in a moment.</string>
    <string name="session_change">Change it</string>
    <string name="session_ready">I\'m ready</string>
    <string name="session_go">Go</string>
    <string name="session_pause">Pause</string>
    <string name="session_resume">Carry on</string>
    <string name="session_skip_rest">Skip the rest</string>
    <string name="session_skip_count_in">Skip the count in</string>
    <string name="session_done_set">Done with this one</string>
    <string name="session_next_up">Next: %1$s</string>
    <string name="session_rest">Rest</string>
    <string name="session_last_time">Last time: %1$d</string>
    <string name="session_target">Aiming for %1$d</string>
    <string name="session_count_one">Count one</string>
    <string name="session_tap_each">Tap the circle each time</string>
    <string name="session_tap_or_sensed">Put the phone in a pocket and it counts, or tap the circle</string>
    <string name="session_of">of %1$d</string>
    <string name="session_speaker_on">Sound on</string>
    <string name="session_speaker_off">Sound off</string>

    <!-- The three exits. Equal weight, never buried, from ADDENDUM-03 Part 2. -->
    <string name="exit_easier">Make it easier</string>
    <string name="exit_skip">Skip this one</string>
    <string name="exit_enough">That\'s enough for today</string>
    <string name="exit_hurts">Something hurts</string>
    <string name="exit_eased">Switched to the easier one. That still counts.</string>

    <!-- What the pain button asks, once the session has already stopped. -->
    <string name="hurt_where">Where does it hurt?</string>
    <string name="hurt_why">Those movements are left out for a week. Nothing else changes.</string>
    <string name="hurt_shoulder">Shoulder</string>
    <string name="hurt_arm">Arm or wrist</string>
    <string name="hurt_back">Back</string>
    <string name="hurt_hip">Hip</string>
    <string name="hurt_knee">Knee</string>
    <string name="hurt_ankle">Ankle or foot</string>
    <string name="hurt_neck">Neck</string>
    <string name="hurt_rather_not">I\'d rather not say</string>
    <string name="hurt_left_out">Left the %1$s movements out this week.</string>
    <string name="hurt_worth_a_word">Worth a word with your doctor about that %1$s.</string>
    <string name="hurt_bring_back">Ready to try the %1$s movements again?</string>
    <string name="hurt_bring_back_yes">Yes, bring them back</string>
    <string name="hurt_bring_back_no">Not yet</string>

    <!-- The done screen. -->
    <string name="done_title">Done. That counts.</string>
    <string name="done_first">That\'s the first one.</string>
    <string name="done_how">How did that feel?</string>
    <string name="felt_easy">Easy</string>
    <string name="felt_about_right">About right</string>
    <string name="felt_hard">Hard</string>
    <string name="done_next_time">Next time</string>
    <plurals name="done_next_shape">
        <item quantity="one">About a minute, starting with %2$s.</item>
        <item quantity="other">About %1$d minutes, starting with %2$s.</item>
    </plurals>

    <!--
      The same six adaptations as adapt_*, said on the done screen, where the session
      being described has not happened yet. Two sets rather than one because "today"
      and "next time" are not the same sentence, and a screen that says the wrong one
      reads as a bug in the app rather than a tense.
    -->
    <string name="next_lighter">A bit lighter than today, because that one was hard.</string>
    <string name="next_swapped">Something else instead of %1$s, while that settles.</string>
    <string name="next_shorter">Shorter than usual, since it has been a few days.</string>
    <string name="next_one_more">One more than today, since the last two felt easy.</string>
    <string name="next_easy_day">An easy one, after two strong ones.</string>
    <string name="next_after_unwell">Gentler for a couple of weeks, while you get back into it.</string>
    <string name="done_save">Save</string>
    <string name="done_change_next">Change next time</string>
    <string name="done_against_last">%1$d, from %2$d</string>
    <string name="done_first_time">%1$d, the first time</string>
    <string name="done_skipped">Left out</string>
    <string name="done_your_own">Your own count: %1$s. That is the same as the phone\'s.</string>

    <!-- The offer card on Today. -->
    <string name="offer_today">Today\'s session</string>
    <plurals name="offer_length">
        <item quantity="one">About a minute</item>
        <item quantity="other">About %1$d minutes</item>
    </plurals>
    <!-- Today's session card. The one thing on Today, and the one button. -->
    <string name="card_label">Today\'s session</string>
    <plurals name="card_minutes">
        <item quantity="one">About a minute</item>
        <item quantity="other">About %1$d minutes</item>
    </plurals>
    <string name="card_go">Start</string>
    <string name="card_no_phone">Do it without the phone</string>
    <string name="card_done">Done today.</string>
    <string name="card_again">Do another</string>
    <string name="card_feeds">For %1$s</string>
    <string name="card_with_both">With a warm up and a cool down.</string>
    <string name="card_with_warm_up">With a warm up.</string>
    <string name="card_with_cool_down">With a cool down.</string>
    <string name="card_nothing">Nothing is set up for today yet.</string>
    <string name="card_minutes_explain">How long today\'s session takes if you do all of it, warm up and cool down included. It is worked out from the movements in it, and nothing here is aiming for a number the app chose.</string>

    <!-- The one noticed line. The person\'s own history, said back to them. -->
    <!--
      "Heel raises: 14, from 10 when you started." Neither number is a quantity of
      the words around it: the first is where the person is now and the second is
      where they began, and "when you started" agrees with nothing. A plural here
      would give identical items in every language and one more thing to get wrong.
    -->
    <string name="noticed_climbed" tools:ignore="PluralsCandidate">%1$s: %2$d, from %3$d when you started.</string>
    <plurals name="noticed_more_days">
        <item quantity="one">One day with a session this week, against %2$d last week.</item>
        <item quantity="other">%1$d days with a session this week, against %2$d last week.</item>
    </plurals>
    <string name="noticed_day">Day %1$d.</string>

    <!--
      What you said you want, and where you are on the way to it. ADDENDUM-03 Part 9.
      Their sentence first, in their words, then one number of their own. The app does
      not say how far there is to go, because it does not know and would be guessing.
    -->
    <string name="want_yours">You said: %1$s</string>
    <!--
      "Stands from a high seat: 11 last time." The number is a count and "last time"
      agrees with nothing, so a plural would give identical items in every language.
    -->
    <string name="want_where" tools:ignore="PluralsCandidate">%1$s: %2$d last time.</string>

    <!--
      The week. ADDENDUM-03 Part 10: a count against a number the person chose, never
      a run of days, and nothing that can be broken.
    -->
    <plurals name="week_so_far">
        <item quantity="one">One this week. %2$d more makes %3$d.</item>
        <item quantity="other">%1$d this week. %2$d more makes %3$d.</item>
    </plurals>
    <plurals name="week_one_more">
        <item quantity="one">One this week. One more makes %3$d.</item>
        <item quantity="other">%1$d this week. One more makes %3$d.</item>
    </plurals>
    <string name="week_met">That\'s %1$d. Anything more is extra.</string>
    <!--
      The number here is the three, four or five the person chose, so it is never one
      and a plural would give identical items in every language.
    -->
    <string name="week_none" tools:ignore="PluralsCandidate">Nothing this week yet. %1$d makes a week.</string>
    <string name="settings_week">Sessions a week</string>
    <string name="settings_week_sub">What you are aiming for. Change it whenever.</string>
    <string name="week_choice">%1$d a week</string>
    <plurals name="noticed_how_many">
        <item quantity="one">One session so far.</item>
        <item quantity="other">%1$d sessions so far.</item>
    </plurals>

    <string name="offer_feeds">For %1$s</string>
    <string name="offer_easy_today">Today\'s an easy one</string>
    <string name="offer_small">Not today, but something small</string>
    <string name="offer_got_a_minute">Got a minute?</string>
    <string name="offer_got_a_minute_sub">One movement, sixty seconds. It counts.</string>

    <!-- The adaptation sentences. One at a time, and never more. -->
    <string name="adapt_lighter">A bit lighter today, since the last one felt hard.</string>
    <string name="adapt_swapped">Swapped %1$s out, since you mentioned it was sore.</string>
    <string name="adapt_shorter">Shorter one to get going again.</string>
    <string name="adapt_one_more">One more than last time. You said the last two felt easy.</string>
    <string name="adapt_easy_day">An easy one after two harder ones.</string>
    <string name="adapt_after_unwell">We\'ll take it slowly for a couple of weeks. That\'s what bodies need after being unwell.</string>

    <!-- Warm up and cool down, each explained once. -->
    <string name="warm_up_why">A minute to get moving first. It makes the rest easier.</string>
    <string name="cool_down_why">A minute to let everything settle. Skip it if you like.</string>

    <!-- What the voice says. Never a number the engine did not produce. -->
    <string name="say_count_in_three">Three</string>
    <string name="say_count_in_two">Two</string>
    <string name="say_count_in_one">One</string>
    <string name="say_count_in_go">Go</string>
    <string name="say_five_more">Five more</string>
    <string name="say_more_than_last">That\'s more than last time</string>
    <string name="say_set_done">That\'s the set</string>
    <string name="say_rest_next">Rest. Next is %1$s</string>
    <string name="say_five_seconds">Five seconds</string>
    <string name="say_session_done">That\'s the session. Well done for turning up.</string>
    <string name="say_up">Up</string>
    <string name="say_down">And down</string>

    <!--
      "%1$d" alone, spoken as each rep is counted. A plural would give identical
      items in every language, and there is no word after the number to agree with.
    -->
    <string name="say_number" tools:ignore="PluralsCandidate">%1$d</string>


    <!--
      Doing a session without the phone. ADDENDUM-03 Part 14: the app reads it out,
      the person does it, and then logs what they managed. The numbers they give are
      marked as their own and nothing anywhere treats them as worth less.
    -->
    <string name="no_phone_title">Without the phone</string>
    <string name="no_phone_intro">Here is the whole session. Read it, or have it read to you, then put the phone down and do it.</string>
    <string name="no_phone_read">Read it out</string>
    <string name="no_phone_stop">Stop reading</string>
    <string name="no_phone_did_it">I have done it</string>
    <string name="no_phone_how_many">How many did you manage?</string>
    <string name="no_phone_save">Save it</string>
    <!--
      "Aiming for 8" beside a name. The number is what was asked for and the words
      before it do not agree with it.
    -->
    <string name="no_phone_asked" tools:ignore="PluralsCandidate">Asked for %1$d</string>
    <!--
      A held movement is asked for in seconds and a walk in minutes, so the phone-free
      screen has to say which. Asking "how many" about a thirty second hold gets an
      answer in repetitions that nothing can use.
    -->
    <plurals name="no_phone_asked_seconds">
        <item quantity="one">Asked for a second</item>
        <item quantity="other">Asked for %1$d seconds</item>
    </plurals>
    <plurals name="no_phone_asked_minutes">
        <item quantity="one">Asked for a minute</item>
        <item quantity="other">Asked for %1$d minutes</item>
    </plurals>
    <string name="no_phone_how_long">How long did you manage?</string>


    <!--
      Consistency, ADDENDUM-03 Part 10, and the look back, Part 9. Four separate weeks
      and one comparison with themselves. Nothing here is a run of anything.
    -->
    <string name="weeks_title">The last four weeks</string>
    <string name="weeks_all">Four weeks, all of them met. That takes doing.</string>
    <plurals name="weeks_most">
        <item quantity="one">One good week and one quiet one. That\'s what most months look like.</item>
        <item quantity="other">%1$d good weeks and one quiet one. That\'s what most months look like.</item>
    </plurals>
    <plurals name="weeks_some">
        <item quantity="one">One good week and %2$d quiet ones. That\'s what most months look like.</item>
        <item quantity="other">%1$d good weeks and %2$d quiet ones. That\'s what most months look like.</item>
    </plurals>
    <string name="weeks_none">Four quiet weeks. The next one starts whenever you like.</string>
    <string name="weeks_bar">Week %1$d: %2$d of %3$d</string>
    <string name="weeks_bar_word" tools:ignore="PluralsCandidate">Week %1$d</string>
    <string name="look_back_title">Then and now</string>

    <!--
      The first month. ADDENDUM-03 Part 16, the second of the four places this app
      is warm. It names what the person said and what they said about it, then and
      now, and evaluates neither. There is no exclamation mark, because Part 16 has
      one in its own example and DESIGN.md section 6 bans them everywhere.
    -->
    <string name="first_month_heading">Your first month</string>
    <string name="just_did_it">You said you wanted %1$s. You just did it.</string>
    <!--
      The ten is the scale and never a count, so these are strings and not plurals.
      A rating of one is still "1 out of ten" and never "1 out of tens", which is
      the sentence a plural would be there to get right.
    -->
    <string name="first_month_forward" tools:ignore="PluralsCandidate">A month ago you put %1$s at %2$d out of ten. Today you put it at %3$d.</string>
    <string name="first_month_back" tools:ignore="PluralsCandidate">A month ago you put %1$s at %2$d out of ten. Today you put it at %3$d. Months go both ways.</string>
    <string name="first_month_same" tools:ignore="PluralsCandidate">A month ago you put %1$s at %2$d out of ten, and today you put it at %2$d. That is a month of holding it there.</string>
    <!--
      "Heel raises: 8 in June, 15 now." Two counts of the same thing, and the words
      between them agree with neither.
    -->
    <string name="look_back_line" tools:ignore="PluralsCandidate">%1$s: %2$d when you started, %3$d now.</string>


    <!--
      The Sunday review. ADDENDUM-03 Part 10, and the only place in the app that looks
      forward. Never notified: it waits on Today for somebody to open it.
    -->
    <string name="sunday_title">Your week</string>
    <string name="sunday_open">Read your week</string>
    <string name="sunday_did">What you did</string>
    <string name="sunday_moved">What moved</string>
    <string name="sunday_noticed">One thing</string>
    <string name="sunday_ahead">The week ahead</string>
    <string name="sunday_nothing_moved">Nothing has moved far enough to be worth saying yet. It will.</string>
    <plurals name="sunday_days">
        <item quantity="one">One day with a session.</item>
        <item quantity="other">%1$d days with a session.</item>
    </plurals>
    <string name="sunday_concrete">%1$s would make %2$d.</string>
    <string name="sunday_ahead_met">You have already met this week. Anything more is extra.</string>


    <!--
      Coming back after a gap. ADDENDUM-03 Part 15. One question, four answers, no free
      text, and the word for a day nobody did anything does not appear here or anywhere.
    -->
    <string name="back_title">Good to see you.</string>
    <string name="back_ask">What has been happening?</string>
    <string name="back_busy">Life got busy</string>
    <string name="back_unwell">I was unwell</string>
    <string name="back_away">I was away</string>
    <string name="back_rather_not">I\'d rather not say</string>
    <string name="back_unwell_said">We\'ll take it slowly for a couple of weeks. That\'s what bodies need after being unwell.</string>
    <string name="back_worth_a_word">If you were in hospital or had a fall, it\'s worth a word with your doctor before the harder movements.</string>
    <string name="back_everything_here">Everything\'s still here.</string>

    <!--
      The chair. Part 15: the chair stand is meaningless if the chair changes, so the
      height is asked once, shown in the setup line, and a change is noted once.
    -->
    <string name="chair_title">About your chair</string>
    <string name="chair_ask">Roughly how high is the seat?</string>
    <string name="chair_low">Low, knees above hips</string>
    <string name="chair_usual">A usual dining chair</string>
    <string name="chair_high">High, hips above knees</string>
    <string name="chair_in_setup">Use the %1$s you told the app about.</string>
    <string name="chair_changed">These are from a different chair, so the numbers are not directly comparable.</string>

</resources>
