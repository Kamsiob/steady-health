<?xml version="1.0" encoding="utf-8"?>
<!-- Same reasoning as backup_rules.xml: nothing leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
