<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions are added in the phase that needs them, never ahead of it, so
      that what this file asks for and what the app does stay the same thing. This
      build still cannot open a network connection.

      Still to come, each with the one sentence that justifies it to a person:
        ACTIVITY_RECOGNITION  counts your steps while a walk is running.
        ACCESS_FINE_LOCATION  measures distance, only if you turn it on.
        INTERNET              downloads the optional reader once, if you ask.
    -->

    <!--
      Asked for the first time somebody turns a reminder on, never before, and
      the app works exactly the same if it is refused. LOGIC.md section 12 caps
      what this permission can ever produce at two notifications a week.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Asked the first time somebody taps "Scan something", never before, and only for
      as long as the camera screen is open. ADDENDUM-03 Part 5: the page is
      photographed, the text is read off it on this phone, and the frames used for
      reading are never written to disk. The app works exactly the same if it is
      refused, minus that one button.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Declared so that a phone with no camera can still install the app. Somebody
      using this on an old tablet loses one feature, not the whole thing.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
      A buzz on every rep, set and rest end, so a session can be followed with the
      phone in a pocket and the sound off. Not a runtime permission, granted at
      install, and the app works the same without a vibrator in the device.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      localeConfig is read from Android 13 onward, where the system settings
      offer a per-app language. Below that it is ignored and the app's own
      language picker is what a person uses. Both are wanted, so lint is told
      this is deliberate.
    -->
    <application
        android:name=".SteadyApplication"
        tools:ignore="UnusedAttribute"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SteadyHealth.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.SteadyHealth.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The only way anything leaves this app. It exposes one cache directory
          and nothing else, so an export hands over exactly the file the person
          asked for and a mistake in a share intent cannot reach the database.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!--
          The widget. ADDENDUM-03 Part 13: today's session, its length, tap to start.
          Exported because the launcher is what places it, which is the only thing
          that ever talks to it.
        -->
        <receiver
            android:name=".widget.SessionWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/session_widget" />
        </receiver>

    </application>
</manifest>
